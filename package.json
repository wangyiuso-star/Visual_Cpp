{
  "name": "cpp-viz",
  "private": true,
  "version": "0.13.0",
  "description": "面向 OI / 算法教学的 C++ 代码逐步可视化工具（浏览器内迷你解释器：变量/容器/图/递归树逐步演示）",
  "keywords": [
    "cpp",
    "c++",
    "visualization",
    "algorithm",
    "teaching",
    "interpreter",
    "oi",
    "react",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wangyiuso-star/Visual_Cpp.git"
  },
  "homepage": "https://github.com/wangyiuso-star/Visual_Cpp#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.8",
    "@uiw/react-codemirror": "^4.25.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
